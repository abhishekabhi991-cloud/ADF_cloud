								"value": "@or(\n    equals(pipeline().parameters.LastLoadValue, null),\n    and(\n        not(equals(activity('LKUP_MAX_VALUE').output.firstRow.MaxValue, null)),\n        greater(\n            activity('LKUP_MAX_VALUE').output.firstRow.MaxValue,\n            pipeline().parameters.LastLoadValue\n        )\n    )\n)\n\n\n",
